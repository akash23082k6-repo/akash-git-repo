{
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Deny",
        "Action": [
          "elasticache:CreateReplicationGroup"
        ],
        "Resource": "arn:aws:elasticache:*:*:replicationgroup:*",
        "Condition": {
          "ForAllValues:StringNotEquals": {
            "aws:TagKeys": "environment"
          }
        }
      },
      {
        "Effect": "Deny",
        "Action": [
          "elasticache:CreateReplicationGroup"
        ],
        "Resource": "arn:aws:elasticache:*:*:replicationgroup:*",
        "Condition": {
          "ForAllValues:StringNotEquals": {
            "aws:TagKeys": "Team"
          }
        }
      },
      {
        "Effect": "Deny",
        "Action": [
          "elasticache:CreateReplicationGroup"
        ],
        "Resource": "arn:aws:elasticache:*:*:replicationgroup:*",
        "Condition": {
          "ForAllValues:StringNotEquals": {
            "aws:TagKeys": "redis-cluster-name"
          }
        }
      }
    ]
  }