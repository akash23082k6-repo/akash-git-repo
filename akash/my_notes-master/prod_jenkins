pipeline {
     agent any
         stages {
             stage('Parameters'){
                 steps {
                     script {
                     properties([
                             parameters([
                                 [$class: 'ChoiceParameter',
                                     choiceType: 'PT_RADIO',
                                     description: 'Select the Environemnt from the Dropdown List',
                                     filterLength: 1,
                                     filterable: false,
                                     name: 'env',
                                     script: [
                                         $class: 'GroovyScript',
                                         fallbackScript: [
                                             classpath: [],
                                             sandbox: false,
                                             script:
                                                 "return['Could not get The environemnts']"
                                         ],
                                         script: [
                                             classpath: [],
                                             sandbox: false,
                                             script:
                                                 "return['acqurier','issuer']"
                                         ]
                                     ]
                                 ],
                                 [$class: 'CascadeChoiceParameter',
                                     choiceType: 'PT_SINGLE_SELECT',
                                     description: 'Select sub environment',
                                     name: 'sub_env',
                                     referencedParameters: 'env',
                                     script:
                                         [$class: 'GroovyScript',
                                         fallbackScript: [
                                                 classpath: [],
                                                 sandbox: false,
                                                 script: "return['Could not get Environment from Env Param']"
                                                 ],
                                         script: [
                                                 classpath: [],
                                                 sandbox: false,
                                                 script: '''
                                                 if (env.equals("acqurier")){
                                                     return['fastag-acquirer-dispute-service', 'dispute-service', 'fastag-acquirer-engine', 'fastag-acquirer-exception-handler', 'fastag-acquirer-frontend', 'fastag-acquirer-netc-engine', 'fastag-acquirer-outbound-manager', 'fastag-acquirer-pass-manager', 'fastag-acquirer-reminder-system', 'fastag-acquirer-reporting', 'fastag-acquirer-sftp-manager', 'fastag-acquirer-toll-onboarding', 'fastag-acquirer-trigger-system', 'fastagacquirerproxysql-service']
                                                 }
                                                 else if(env.equals("issuer")){
                                                     return['fastag-asset-handler', 'fastag-issuance-migration', 'fastag-issuance', 'fastag-issuer-efkon-netc-engine', 'fastag-issuer-reporting', 'fastag-issuer-switch', 'fastag-issuerproxysql-service', 'fastag-trans-dashboard', 'fastag-transport-panel-web']
                                                 }
                                                 '''
                                             ]
                                     ]
                                 ],
                              string(defaultValue: '', description: 'Enter date in YYYY-MM-DD Format', name: 'Date')
                             ])
                         ])
                     }
                 }
             }
     stage('Download the s3 logs') {
             steps {
                 sh '/usr/local/bin/aws s3 sync s3://fastag-prod-log-backup/paytmbank/prod/fastag/${sub_env}/application/${Date}/archive/ data/${sub_env}/${Date}/ --profile fastag-prod'
             }
         }

    stage('Secure copy to other remote host and delete logs from jenkins server') {
            steps {

                 sh '''
                
                 cd /data/jenkins/jenkins/workspace/prod-logs-backup-s3-download/data/
                 scp -r ${sub_env}/ ec2-user@172.23.206.18:/home/ec2-user/s3_logs/
                 rm -rf ${sub_env}

                 '''
             }
         }
    } 
         
 }