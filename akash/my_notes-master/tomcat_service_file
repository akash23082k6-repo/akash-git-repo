[Unit]
Description=Apache Tomcat Web Application Container
After=syslog.target network.target

[Service]
Type=forking

Environment=JAVA_HOME=/usr/lib/jvm/java-1.8.0-openjdk-1.8.0.332.b09-1.el7_9.x86_64/jre
Environment=CATALINA_PID=/tomcat/apache-tomcat-8.5.71/temp/tomcat.pid
Environment=CATALINA_HOME=/tomcat/apache-tomcat-8.5.71
Environment=CATALINA_BASE=/tomcat/apache-tomcat-8.5.71
Environment=CATALINA_OPTS=
Environment="JAVA_OPTS=-Dfile.encoding=UTF-8 -Dnet.sf.ehcache.skipUpdateCheck=true \
-XX:+UseConcMarkSweepGC -XX:+CMSClassUnloadingEnabled \
-XX:+UseParNewGC -Xms2g -Xmx4g"

ExecStart=/tomcat/apache-tomcat-8.5.71/bin/startup.sh
ExecStop=/tomcat/apache-tomcat-8.5.71/bin/shutdown.sh

[Install]
WantedBy=multi-user.target